---
import RemyRoom from '../../layouts/RemyRoom.astro';
import StoryHook from '../../components/StoryHook.astro';
import FilmPlayer from '../../components/FilmPlayer.astro';
import RemyRoomProcess from '../../components/RemyRoomProcess.astro';
import { MAIN_WORKS, type Work } from '../../data/works';
import { roomOf } from '../../data/process';
import { metaRows, nextOf } from '../../data/room';
export function getStaticPaths(){return MAIN_WORKS.map(work=>({params:{slug:work.slug},props:{work}}));}
const { work } = Astro.props as { work: Work };
const intro = roomOf(work.slug)?.overview.intro ?? [];
const facts = metaRows(work).filter(row=>row.key==='tools'||row.key==='period');
const next = nextOf(work.slug);
const poster = work.slug==='butter' ? '/media/remy-preview/butter/poster.jpg' : '/media/remy-preview/'+work.slug+'/cover.'+(work.slug==='firstimpression'?'png':'jpg');
---
<RemyRoom title={work.title} subtitle={work.creditNote} selected={work.slug}>
  <main id="main" class="room-work" data-work={work.slug}>
    <StoryHook work={work} />
    <section class="room-film room-wrap" id="full-film" data-full-film aria-labelledby="room-film-title">
      <div class="room-section-heading"><h2 id="room-film-title">풀영상</h2><span>{work.format} · {work.duration}</span></div>
      <FilmPlayer id={work.youtubeId} title={work.title} poster={poster} ratio={work.ratio} duration={work.duration} follow />
      {intro.length>0&&<div class="room-intro"><p>{intro[0].t}</p>{intro.length>1&&<details class="room-details"><summary>작품 소개 더 읽기</summary>{intro.slice(1).map(line=><p>{line.t}</p>)}</details>}</div>}
    </section>
    <RemyRoomProcess work={work} />
    {facts.length>0&&<details class="room-details room-facts room-wrap"><summary>제작 정보</summary><dl>{facts.map(row=><div><dt>{row.k}</dt><dd>{row.v}</dd></div>)}</dl></details>}
    <a class="room-next room-wrap" href={next.href}><span>다음 작품</span><strong>{next.title}</strong><span aria-hidden="true">↗</span></a>
  </main>
</RemyRoom>
