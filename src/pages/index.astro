---
/**
 * 홈 = 인트로(잠든 벽) + 작업 벽(docs/v4-redesign.md 2절 · 메인 지시 10-14 · Kavieng 2-3).
 * 벽 = React Bits DomeGallery(흑백 · 마우스가 올라간 타일만 컬러 · 드래그 · 휠 · 3칸은 후킹 클립) — src/components/react/WorkWall.tsx.
 * 인트로 동안 같은 벽이 카메라 틀([data-cam]) 안에서 ×2.2 · 어둡게 · 흐리게 · 아주 느리게 돌고, 입장하면 물러나 지금 크기가 된다(src/scripts/site.ts initIntro).
 * 아래 가운데 읽음 · 오른쪽 아래 작품 7편 목록 · 왼쪽 아래 「드래그해서 둘러보기」. 카운터 · 필터 탭 없음.
 */
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Intro from '../components/Intro.astro';
import WorkWall from '../components/react/WorkWall';
import { MAIN_WORKS, WORKS } from '../data/works';
import { WALL_TILES, wallOrder } from '../data/wall';

const order = wallOrder(WALL_TILES);
const images = order.map((t) => ({ src: t.src, slug: t.slug, k: t.k, avif: t.avif, webp: t.webp }));
const works = WORKS.map((w) => ({
  slug: w.slug,
  title: w.title,
  format: w.format ?? w.category ?? '',
  year: w.year ?? '',
  href: w.group === 'main' ? `/works/${w.slug}/` : `/tools/#${w.slug}`,
}));
// 벽 칸 3개 = 주력 3편의 후킹 클립(음소거 · 반복 · 보일 때만 재생)
const videos = MAIN_WORKS.filter((w) => w.hook).map((w) => ({ slug: w.slug, src: w.hook!.clip, poster: w.hook!.poster }));
---

<Base page="home">
  <Intro />
  <div class="wall-cam" data-cam>
    <WorkWall client:load images={images} works={works} videos={videos} hint="드래그해서 둘러보기" listLabel="작품" />
  </div>
  <TopBar variant="home" />
</Base>
