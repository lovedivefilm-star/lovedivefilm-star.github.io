---
/**
 * 404 — Kavieng /404(정밀 2-6 · 8-6): 흐린 흑백 격자 7×5 = 35칸(완성본 프레임 12장 돌려쓰기 · 3번째마다 더 어둡고 흐림 ·
 * 칸마다 불투명도 .28 + ((i×13) mod 47)/100) · 가운데 문장 하나 + 타원 덮개 · 「작품으로 돌아가기 ↗」 · 커서 시차(±15 × ±8px · z −49 · .95s).
 * 문장은 화면 안내 낱말(작가 문장이 정해지면 바꾼다 — docs/빈자리.md).
 */
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { WALL_TILES, wallOrder } from '../data/wall';

const frames = wallOrder(WALL_TILES).slice(0, 12);
const cells = Array.from({ length: 35 }, (_, i) => ({
  t: frames[i % frames.length],
  o: (0.28 + ((i * 13) % 47) / 100).toFixed(2),
  dim: i % 3 === 2,
  col: (i % 7) - 3,
  row: Math.floor(i / 7) - 2,
}));
---

<Base page="404" title="없는 페이지">
  <main class="e404" data-404>
    <div class="e404-grid" aria-hidden="true">
      {
        cells.map((c) => (
          <i class:list={[{ dim: c.dim }]} style={`--o:${c.o}`} data-c={c.col} data-r={c.row}>
            <picture>
              {c.t?.avif && <source type="image/avif" srcset={c.t.avif} sizes="200px" />}
              <img src={c.t?.src} alt="" decoding="async" />
            </picture>
          </i>
        ))
      }
    </div>
    <div class="e404-cover" aria-hidden="true"></div>
    <a class="e404-name" href="/">{SITE.name}</a>
    <p class="e404-no">404</p>
    <h1 class="e404-msg">찾는 페이지가 없습니다</h1>
    <a class="e404-back" href="/"><span>작품으로 돌아가기</span><span aria-hidden="true">↗</span></a>
  </main>
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-404]');
      if (!root) return;
      setTimeout(function () { root.classList.add('ready'); }, 80);
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var cells = root.querySelectorAll('.e404-grid i');
      addEventListener('pointermove', function (e) {
        var x = e.clientX / innerWidth - 0.5, y = e.clientY / innerHeight - 0.5;
        cells.forEach(function (el) {
          var c = +el.dataset.c, r = +el.dataset.r;
          var near = Math.max(0, 1 - Math.hypot(c, r) / 1.5);
          el.style.setProperty('--px', (c * x * (11 + near * 20)).toFixed(2) + 'px');
          el.style.setProperty('--py', (r * y * (9 + near * 18)).toFixed(2) + 'px');
          el.style.setProperty('--pz', (-Math.abs(c * x + r * y) * 22).toFixed(2) + 'px');
        });
      });
    })();
  </script>
</Base>
