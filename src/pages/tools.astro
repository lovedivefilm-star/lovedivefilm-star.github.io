---
/**
 * 툴 방 — 4편 카드 → 모달에서 사이트 안 유튜브 재생.
 * 따온 곳: 카드 = Adam Bricker(정밀 adambricker.md §5 — 머리줄 번호 모노 · + · 연도 / 포스터 / 제목 · 분류 / 크레딧 2줄 · 칸 사이 1px 세로선 ·
 *          호버 시 번호가 아래서 올라옴 0.5s expo-out · + 1.5s expo-inOut · 나머지 카드 .5 0.25s). 포스터 위 덮개 · 그라데이션 없음.
 * 모달: Josh Goldsmith 플레이어(정밀 joshgoldsmith.md §5 — 백드롭 0.24s · 영상 뷰포트 86% · 바깥 우상단 ✕).
 * 영상 위에는 아무것도 얹지 않는다(✕ 는 영상 바깥 위, 제목은 영상 아래).
 */
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import { TOOL_WORKS } from '../data/works';
---

<Base title="툴" here={{ no: '04', label: '툴' }}>
  <section class="tools" aria-label="툴">
    <div class="side">
      <p class="eyebrow">04 — 툴</p>
      <h1>툴</h1>
      <Placeholder kind="author-copy" block />
      <p class="meta">{TOOL_WORKS.length}편 · 단독 작업 · 누르면 이 자리에서 재생</p>
    </div>
    <div class="cards">
      {TOOL_WORKS.map((t, k) => (
        <button type="button" class="card" data-tool={t.slug} data-yt={t.youtubeId} data-title={t.title} aria-label={`${t.title} 재생`}>
          <span class="card-head">
            <span class="n-mask"><span class="n">{String(k + 1).padStart(2, '0')}</span></span>
            <span class="plus" aria-hidden="true"></span>
            <span class="y">{t.year}</span>
          </span>
          <span class="thumb"><img src={t.poster} alt="" width="960" height="540" loading="eager" decoding="async" /></span>
          <span class="row">
            <span class="tt">{t.title}{t.label && <span class="tag">{t.label}</span>}</span>
            <span class="cat">{t.category}</span>
          </span>
          <span class="cr">
            <span>제작 김영건 · 단독 · {t.duration} · {t.ratio}</span>
            <span>툴 <Placeholder kind="tool" /> · 출처 <Placeholder kind="source" /></span>
          </span>
        </button>
      ))}
    </div>
  </section>

  <div class="modal" data-modal role="dialog" aria-modal="true" aria-label="재생" hidden slot="after">
    <div class="modal-bd" data-close></div>
    <div class="modal-box">
      <button type="button" class="modal-x" data-close aria-label="닫기 (ESC)"><span aria-hidden="true"></span></button>
      <div class="player h" data-video data-ratio="16:9" data-youtube-id="" data-title=""></div>
      <p class="modal-cap"><span class="modal-t"></span><span class="kbd">ESC</span></p>
    </div>
  </div>
</Base>
