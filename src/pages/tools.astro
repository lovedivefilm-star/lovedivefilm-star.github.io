---
import RemyRoom from '../layouts/RemyRoom.astro';
import FilmPlayer from '../components/FilmPlayer.astro';
import { TOOL_WORKS } from '../data/works';
import { TOOLS_LABEL } from '../data/site';
import { TECHNICAL_WORKFLOWS } from '../data/technical-workflows';
import '../styles/technical-workflows.css';
const posterOf = (slug:string) => '/media/remy-preview/technical/' + (slug==='kinetic'?'poster':slug) + '.jpg';
---
<RemyRoom title={TOOLS_LABEL} subtitle="모션 그래픽 · 타이틀 · AI 영상" selected="technical" page="tools">
  <main id="main" class="room-tools room-wrap" data-technical-room>
    <nav class="room-tool-list" aria-label="테크니컬 작업 선택">{TOOL_WORKS.map((work,index)=><a href={'?work='+work.slug} data-tool-select={work.slug} aria-current={index===0?'true':undefined}><img src={posterOf(work.slug)} alt="" width="160" height="90" /><span>{work.title}<small>{[work.category,work.label].filter(Boolean).join(' · ')}</small></span></a>)}</nav>
    <div class="room-tool-panels">{TOOL_WORKS.map(work=><section class="room-tool-panel" id={work.slug} data-tool-panel={work.slug} aria-labelledby={'tool-'+work.slug}>
      <div class="room-section-heading"><h2 id={'tool-'+work.slug}>{work.title}</h2><span>{[work.category,work.label,work.duration].filter(Boolean).join(' · ')}</span></div>
      <FilmPlayer id={work.youtubeId} title={work.title} poster={posterOf(work.slug)} ratio={work.ratio} duration={work.duration} />
      <dl class="room-technical-credit"><div><dt>제작</dt><dd>김영건 · 단독</dd></div><div><dt>사용 툴</dt><dd>{TECHNICAL_WORKFLOWS[work.slug].tools.join(' · ')}</dd></div>{work.sourceNote&&<div><dt>출처</dt><dd>{work.sourceNote}</dd></div>}</dl>
      <section class="room-technical-workflow" aria-labelledby={'flow-'+work.slug}><h3 id={'flow-'+work.slug}>작업 흐름</h3><ol>{TECHNICAL_WORKFLOWS[work.slug].steps.map(step=><li>{step}</li>)}</ol></section>
    </section>)}</div>
    <a class="room-next" href="/scripts/"><span>다음 항목</span><strong>대본</strong><span aria-hidden="true">↗</span></a>
  </main>
</RemyRoom>
