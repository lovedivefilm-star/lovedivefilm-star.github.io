---
/**
 * 모든 방의 틀 — v4. 글꼴 2종 · Astro View Transitions(<ClientRouter />) · 공통 스크립트.
 * 방 사이 전환 = 브라우저 View Transitions(Astro ClientRouter) — 벽에서 누른 그림이 작품 방의 판으로 이어진다(transition:name="plate").
 * 직접 짠 블록 디졸브는 삭제(설계서 3절).
 */
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/global.css';
import { FONT_ORIGINS, SANS_CSS, SERIF, SERIF_FONTS, SITE } from '../data/site';

type Props = {
  title?: string;
  /** body[data-page] — home | work | tools | 404 */
  page: 'home' | 'work' | 'tools' | '404';
  description?: string;
};
const { title, page, description } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const favicon =
  'data:image/svg+xml,' +
  encodeURIComponent("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='#050505'/><circle cx='16' cy='16' r='4.5' fill='#0090FF'/></svg>");
const serifAlt = Object.fromEntries(Object.entries(SERIF_FONTS).map(([k, v]) => [k, v.css]));
---

<!doctype html>
<html lang="ko" data-serif={SERIF}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? SITE.description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description ?? SITE.description} />
    <link rel="icon" href={favicon} />
    {FONT_ORIGINS.map((o) => <link rel="preconnect" href={o} crossorigin />)}
    <link rel="stylesheet" href={SANS_CSS} />
    <link rel="stylesheet" href={SERIF_FONTS[SERIF].css} data-serif-css />
    <script is:inline define:vars={{ serifAlt, serifDefault: SERIF }}>
      /* 검수용 글꼴 바꿔 보기 — ?serif=noto | hahmlet (기본은 src/data/site.ts SERIF). 방을 옮겨도 유지(세션). */
      (function () {
        var KEY = 'yk-serif';
        function apply() {
          var want = null;
          try {
            var q = new URLSearchParams(location.search).get('serif');
            if (q && serifAlt[q]) sessionStorage.setItem(KEY, q);
            want = sessionStorage.getItem(KEY);
          } catch (e) {}
          if (!want || !serifAlt[want] || want === serifDefault) return;
          document.documentElement.setAttribute('data-serif', want);
          if (!document.querySelector('link[data-serif-alt="' + want + '"]')) {
            var l = document.createElement('link');
            l.rel = 'stylesheet';
            l.href = serifAlt[want];
            l.setAttribute('data-serif-alt', want);
            document.head.appendChild(l);
          }
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body data-page={page}>
    <slot />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
