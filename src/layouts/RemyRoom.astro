---
import { SITE, CONTACT_EMAIL } from '../data/site';
import ContactMenu from '../components/ContactMenu.astro';
import '../styles/remy-fonts.css';
import '../styles/remy-room.css';
import '../styles/floating-film.css';
type Props = { title: string; subtitle?: string; selected: string; page?: 'work' | 'tools'; canonicalPath?: string; noindex?: boolean };
const { title, subtitle, selected, page = 'work', canonicalPath, noindex = false } = Astro.props;
const returnHref = '/?work=' + selected;
const canonical = new URL(canonicalPath ?? (page === 'tools' ? '/tools/' : `/works/${selected}/`), SITE.url).href;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}<meta name="theme-color" content="#111111" />
    <meta name="description" content={SITE.description} /><link rel="canonical" href={canonical} />
    <title>{title} · {SITE.name}</title>
    <script is:inline>
      // Hero v1 pre-roll: keep the story paper and screen closed until the hook script takes over,
      // so the first paint does not flash the finished state. Without JS nothing is hidden.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('story-pre');
        setTimeout(() => document.documentElement.classList.remove('story-pre'), 4000);
      }
    </script>
  </head>
  <body class="remy-room" data-page={page}>
    <a class="room-skip" href="#main">본문으로</a>
    <header class="room-header">
      <a class="room-name" href={returnHref} data-room-return>{SITE.name}</a>
      <div class="room-title"><h1 data-title>{title}</h1>{subtitle && <p>{subtitle}</p>}</div>
      <nav class="room-nav" aria-label="주요 메뉴"><a href={returnHref} data-room-return>작품 선택</a><a href="/scripts/">대본</a><ContactMenu /></nav>
    </header>
    <slot />
    <footer class="room-footer"><a href={returnHref} data-room-return>작품 선택으로</a>{CONTACT_EMAIL && <a href={'mailto:' + CONTACT_EMAIL}>{CONTACT_EMAIL}</a>}</footer>
    <dialog class="media-dialog" data-media-dialog aria-labelledby="media-dialog-title"><div class="media-dialog-head"><h2 id="media-dialog-title" data-media-title>크게 보기</h2><button type="button" data-media-close aria-label="크게 보기 닫기">닫기 ×</button></div><div class="media-dialog-stage" data-media-stage></div></dialog>
    <script>import '../scripts/rebuild'; import '../scripts/remy-room'; import '../scripts/floating-film';</script>
  </body>
</html>
