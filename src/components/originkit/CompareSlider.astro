---
/**
 * OriginKit MCP component: compare-slider / ui/compare-slider.tsx (2026-10-15).
 * Source capture: originkit_compare_slider_source.txt, retained with this task's research.
 * Actual Astro/vanilla port: normalized clientX, clamp, 2/10-point keys and slider ARIA.
 * Adaptations: contain instead of cover; horizontal intent instead of touch-action:none;
 * static images without JS, no hover-follow, autoplay, React or Tailwind dependency.
 */
type ComparisonImage = { src: string; alt: string; width: number; height: number; label: string };
type Props = { before: ComparisonImage; after: ComparisonImage; label?: string; start?: number; id?: string };
const { before, after, label = '콘티와 완성 화면 비교', start = 50, id } = Astro.props;
const validSize = (image: ComparisonImage) => Number.isFinite(image.width) && Number.isFinite(image.height) && image.width > 0 && image.height > 0;
if (!validSize(before) || !validSize(after) || Math.abs(before.width / before.height - after.width / after.height) > .005) {
  throw new Error('CompareSlider requires two images with positive dimensions and the same aspect ratio.');
}
const initial = Number.isFinite(start) ? Math.max(0, Math.min(100, start)) : 50;
const uid = id ?? 'origin-compare-' + crypto.randomUUID();
const descriptionId = uid + '-description';
const helpId = uid + '-help';
---
<figure class="origin-compare" data-origin-compare data-originkit="compare-slider" data-compare-start={initial} data-compare-label={label} data-before-label={before.label} data-after-label={after.label} style={'--compare-pos:' + initial + '%;--compare-aspect:' + before.width + ' / ' + before.height}>
  <div class="origin-compare-key" data-compare-key hidden>
    <span>{before.label}</span><span>{after.label}</span>
  </div>
  <div class="origin-compare-frame" data-compare-control data-compare-description={descriptionId + ' ' + helpId}>
    <div class="origin-compare-layer" data-compare-image="before">
      <img src={before.src} alt={before.alt} width={before.width} height={before.height} loading="lazy" decoding="async" draggable="false" />
      <p class="origin-compare-static-label">{before.label}</p>
    </div>
    <div class="origin-compare-layer" data-compare-image="after">
      <img src={after.src} alt={after.alt} width={after.width} height={after.height} loading="lazy" decoding="async" draggable="false" />
      <p class="origin-compare-static-label">{after.label}</p>
    </div>
    <span class="origin-compare-line" data-compare-decoration aria-hidden="true" hidden></span>
    <span class="origin-compare-handle" data-compare-decoration aria-hidden="true" hidden>
      <svg width="7" height="10" viewBox="0 0 7 10" fill="none" aria-hidden="true"><path d="M5.5 1L1.5 5l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <svg width="7" height="10" viewBox="0 0 7 10" fill="none" aria-hidden="true"><path d="M1.5 1l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
  </div>
  <figcaption class="origin-compare-caption">
    <p id={descriptionId} class="origin-compare-description">{before.label}: {before.alt}. {after.label}: {after.alt}.</p>
    <p id={helpId} data-compare-help hidden>가로로 움직이거나 왼쪽·오른쪽 화살표로 비교하세요. Shift는 크게 이동, Home·End는 한쪽 전체 보기입니다.</p>
    <p data-compare-fallback-help>콘티와 완성 화면을 순서대로 보여 줍니다.</p>
  </figcaption>
</figure>

<script>
  import '../../scripts/originkit-compare';
</script>

<style>
  .origin-compare { width: min(100%, 420px); margin: 0; color: var(--fg, #292a2c); }
  .origin-compare-key { display: flex; justify-content: space-between; gap: 16px; margin-bottom: 12px; font-size: 16px; line-height: 1.5; }
  .origin-compare-key > :last-child { text-align: right; }
  .origin-compare-frame { display: grid; gap: 20px; position: relative; width: 100%; min-width: 0; }
  .origin-compare-layer { min-width: 0; }
  .origin-compare-layer > img { display: block; width: 100%; height: auto; object-fit: contain; user-select: none; pointer-events: none; }
  .origin-compare-static-label { margin: 10px 0 0; font-size: 16px; line-height: 1.5; }
  .origin-compare[data-compare-ready='true'] .origin-compare-frame { display: block; aspect-ratio: var(--compare-aspect); overflow: hidden; background: var(--media-bg, #050505); touch-action: pan-y; cursor: ew-resize; user-select: none; outline-offset: 4px; }
  .origin-compare[data-compare-ready='true'] .origin-compare-layer { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .origin-compare[data-compare-ready='true'] .origin-compare-layer > img { width: 100%; height: 100%; object-fit: contain; }
  .origin-compare[data-compare-ready='true'] .origin-compare-layer[data-compare-image='after'] { clip-path: inset(0 0 0 var(--compare-pos)); }
  .origin-compare[data-compare-ready='true'] .origin-compare-static-label { display: none; }
  .origin-compare-line { position: absolute; z-index: 1; top: 0; bottom: 0; left: calc(var(--compare-pos) - 1px); width: 2px; background: #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.3); pointer-events: none; }
  .origin-compare-handle { position: absolute; z-index: 2; top: 50%; left: clamp(25px, var(--compare-pos), calc(100% - 25px)); width: 50px; height: 50px; margin: -25px 0 0 -25px; border: 1px solid rgba(0,0,0,.35); border-radius: 50%; background: #fff; color: #292a2c; box-shadow: 0 2px 10px rgba(0,0,0,.2); display: flex; align-items: center; justify-content: center; gap: 5px; pointer-events: none; }
  .origin-compare-caption { margin-top: 14px; font-size: 16px; line-height: 1.6; color: var(--muted, #737476); }
  .origin-compare-caption p { margin: 0; }
  .origin-compare-description { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }
</style>
