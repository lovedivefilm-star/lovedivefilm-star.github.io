---
/**
 * 사이트 안 유튜브 — 포스터 + 재생 단추, 누르면 그 자리에 youtube-nocookie iframe(유튜브로 나가지 않는다).
 * 따온 곳: JM 포폴 · lite-youtube-embed 방식(썸네일 → 그 자리 재생) · 재생 표시 = Bricker 가운데 원 120×120 1px 선(정밀 adambricker.md §5 — 포스터 단계에서만).
 * 영상 위에는 재생 표시 말고 아무것도 얹지 않는다(재생하면 iframe 으로 통째 바뀐다).
 */
import type { Ratio } from '../data/works';

type Props = { youtubeId: string; ratio: Ratio; title: string; poster: string };
const { youtubeId, ratio, title, poster } = Astro.props;
const [w, h] = ratio === '9:16' ? [720, 1280] : [1280, 720];
---

<div class:list={['player', ratio === '9:16' ? 'v' : 'h']} data-video data-ratio={ratio} data-youtube-id={youtubeId} data-title={title}>
  <button type="button" class="poster" aria-label={`${title} 재생 — 이 자리에서 재생`}>
    <img src={poster} alt="" width={w} height={h} loading="eager" decoding="async" />
    <span class="play play-ring" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 1.5 L14.5 8 L3 14.5 Z"></path></svg><span class="play-t">재생</span></span>
  </button>
</div>
