---
/**
 * 상단 바 — 상자 없음(설계서 2절).
 *  · 홈(Kavieng 2-3 벽 위): 이름 700 18px + 직함 12px | `작품` · `연락 ↗`
 *  · 방(Kavieng 2-4): `← 작품` · 이름 | `← 이전` · `다음 →`(작품 이름 작게 — 키보드 ← → 와 같은 이동) · `연락 ↗`
 * 연락은 src/data/site.ts CONTACT_EMAIL 이 있을 때만 그린다(빈자리 표시 금지).
 */
import { CONTACT_EMAIL, SITE } from '../data/site';

type Link = { href: string; title: string };
type Props = { variant: 'home' | 'room'; prev?: Link; next?: Link };
const { variant, prev, next } = Astro.props;
---

<header class="tb">
  <nav class="tb-in" data-nav aria-label="사이트" style="display:contents">
    {
      variant === 'home' ? (
        <div class="tb-l">
          <a class="tb-name" href="/">{SITE.name}</a>
          <span class="tb-job">{SITE.job}</span>
        </div>
      ) : (
        <div class="tb-l">
          <a class="u tb-back" href="/" data-back>← 작품</a>
          <a class="tb-name" href="/">{SITE.name}</a>
        </div>
      )
    }
    <div class="tb-r">
      {variant === 'home' && <a class="u" href="/" aria-current="page">작품</a>}
      {prev && <a class="u tb-pn" href={prev.href} rel="prev" data-prev aria-label={`이전 작품 ${prev.title}`}>{`← ${prev.title}`}</a>}
      {next && <a class="u tb-pn" href={next.href} rel="next" data-next-link aria-label={`다음 작품 ${next.title}`}>{`${next.title} →`}</a>}
      {CONTACT_EMAIL && <a class="u" href={`mailto:${CONTACT_EMAIL}`} data-nav="contact">연락 ↗</a>}
    </div>
  </nav>
</header>
