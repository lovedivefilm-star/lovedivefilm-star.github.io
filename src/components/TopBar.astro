---
/**
 * 상단 바 — 모든 방 공통(v5 1단계 · 메인 지시 10-14 · docs/review-gate.md 5-1).
 *  · 왼쪽 「김영건」(홈 링크 — 옛 「← 작품」 은 같은 곳으로 가는 두 번째 링크라 뺐다). 홈에서는 이름(16px 700 · h1) 옆에 직무 한 줄(16px — 작가 10-14 「AI CREATOR & 드라마 대본 작가」).
 *    홈 첫 방문 인트로의 큰 이름이 입장 때 이 자리로 줄어 들어온다(site.ts initHome · GSAP Flip).
 *  · 오른쪽 「연락」(mailto) + 「주소 복사」(누르면 「복사됨」 1.5초 — src/scripts/site.ts initContact). 방에서는 그 앞에 「← 이전 · 다음 →」.
 *  · 눌림 높이 ≥ 44px · 글자 14px(정보 ≥ 14px).
 * 연락은 src/data/site.ts CONTACT_EMAIL 이 있을 때만 그린다(빈자리 표시 금지).
 */
import { CONTACT_EMAIL, SITE } from '../data/site';

type Link = { href: string; title: string };
type Props = { variant: 'home' | 'room'; prev?: Link; next?: Link };
const { variant, prev, next } = Astro.props;
---

<header class:list={['tb', variant === 'home' && 'tb--home']}>
  <nav class="tb-in" data-nav aria-label="사이트">
    {
      variant === 'home' ? (
        <div class="tb-l tb-l--home">
          <h1 class="tb-h">
            <a class="tb-a tb-name" href="/" aria-current="page" data-bar-name>{SITE.name}</a>
          </h1>
          <p class="tb-job" data-job>{SITE.job}</p>
        </div>
      ) : (
        <div class="tb-l">
          <a class="tb-a tb-name" href="/" data-back aria-label={`${SITE.name} — 홈(작품)으로`}>{SITE.name}</a>
        </div>
      )
    }
    <div class="tb-r">
      {prev && <a class="u tb-a tb-pn" href={prev.href} rel="prev" data-prev aria-label={`이전 작품 ${prev.title}`}>{`← ${prev.title}`}</a>}
      {next && <a class="u tb-a tb-pn" href={next.href} rel="next" data-next-link aria-label={`다음 작품 ${next.title}`}>{`${next.title} →`}</a>}
      {
        CONTACT_EMAIL && (
          <a class="u tb-a" href={`mailto:${CONTACT_EMAIL}`} data-nav="contact" title={CONTACT_EMAIL} aria-label={`연락 — 메일 쓰기 ${CONTACT_EMAIL}`}>
            연락
          </a>
        )
      }
      {
        CONTACT_EMAIL && (
          <button type="button" class="tb-a tb-copy" data-copy={CONTACT_EMAIL} aria-label={`메일 주소 복사 — ${CONTACT_EMAIL}`}>
            <span data-copy-label>주소 복사</span>
          </button>
        )
      }
      {CONTACT_EMAIL && <span class="sr" aria-live="polite" data-copy-status />}
    </div>
  </nav>
</header>
