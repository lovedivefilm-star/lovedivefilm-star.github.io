---
/**
 * 영상 칸 — Kavieng 2-4 리드 미디어(폭 100% · 높이 min(86svh, 940px) · 바탕 #050505 · 영상 위 덮개 없음).
 * 처음 = 후킹 클립(로컬 · 음소거 · 반복)이 움직이는 포스터 → 「▶ 풀영상 재생」(칸 아래) 또는 클립을 누르면
 * 같은 자리에 lite-youtube(justinribeiro, MIT) — 바로 iframe(youtube-nocookie, 자동 재생)으로 바뀐다(src/scripts/site.ts playIn).
 * 9:16 은 높이 기준 가운데 세로 플레이어 + 양옆 #050505, 16:9 는 전폭.
 * 툴 방은 hook 없이 처음부터 lite-youtube(우리 포스터 slot) — 누르면 그 자리 재생.
 */
type Props = {
  id: string;
  title: string;
  ratio: '9:16' | '16:9';
  poster: string;
  duration: string;
  hook?: { clip: string; poster: string };
  /** 칸 아래 재생 줄의 글 */
  playLabel?: string;
  class?: string;
  /** 방 전환 이름 — 벽에서 누른 타일 그림이 이 칸으로 이어진다(view-transition-name) */
  vt?: string;
};
const { id, title, ratio, poster, duration, hook, playLabel = '풀영상 재생', class: cls, vt } = Astro.props;
---

<div class:list={['vbox', cls]} data-vbox>
  <div class="vcell" data-video data-ratio={ratio} data-youtube-id={id} data-video-title={title} data-poster={poster} style={vt ? `view-transition-name:${vt}` : undefined}>
    {
      hook ? (
        <button class="hook" type="button" data-play aria-label={`${title} 풀영상 재생`}>
          <video src={hook.clip} poster={hook.poster} muted loop playsinline autoplay preload="metadata" aria-hidden="true" />
        </button>
      ) : (
        <lite-youtube videoid={id} nocookie videotitle={title} videoplay="재생" params="rel=0&playsinline=1">
          <img slot="image" src={poster} alt="" loading="lazy" decoding="async" />
        </lite-youtube>
      )
    }
  </div>
  <button class="play" type="button" data-play aria-pressed="false">{`▶ ${playLabel} · ${duration}`}</button>
</div>
