---
/** A short screenplay-to-image introduction. The full film and process never wait for this animation. */
import type { Work } from '../data/works';
import ScriptLine from './ScriptLine.astro';
import { HOOK_EXCERPTS } from '../data/hook-excerpts';

type Props = { work: Work };
const { work } = Astro.props;
const excerpt = HOOK_EXCERPTS[work.slug];
const ratio = work.hook?.aspect ?? (work.ratio === '9:16' ? '9 / 16' : '16 / 9');
const whole = excerpt?.scene_all;
---
<section class="story-hook wrap" data-story-hook data-story-portrait={work.ratio==='9:16'?'true':undefined} aria-label="대본에서 장면으로">
  <div class="story-copy">
    <div class="script-document story-document" data-script-document>
      <div class="script-paper" data-story-paper>
        {excerpt && <p class="script-document-label">{excerpt.label}</p>}
        {excerpt?.scene && <ScriptLine line={excerpt.scene} src={excerpt.src} />}
        <div class="script-context story-context">
          {excerpt?.lines.map((line, index) => <ScriptLine line={line} src={excerpt.src} focused={index === excerpt.anchor} anchor={index === excerpt.anchor} />)}
        </div>
      </div>
    </div>
  </div>
    <div class="story-reading-actions">
      {excerpt && whole && whole.lines.length > excerpt.lines.length && (
        <details class="story-more">
          <summary>이 씬 대본 모두 읽기</summary>
          <div class="script-document story-expanded-document" data-script-document>
            <div class="script-paper">
              <div class="script-context" data-story-reader tabindex="0" aria-label={excerpt.label + ' 전체'}>
                <p class="script-document-label">{excerpt.label}</p>
                {excerpt.scene && <ScriptLine line={excerpt.scene} src={excerpt.src} />}
                {whole.lines.map((line, index) => <ScriptLine line={line} src={excerpt.src} focused={index >= whole.from && index <= whole.to} />)}
              </div>
            </div>
          </div>
        </details>
      )}
      {excerpt && !whole && (
        <details class="story-more story-more--narrow">
          <summary>대본 모두 읽기</summary>
          <div class="script-document story-expanded-document" data-script-document>
            <div class="script-paper">
              <div class="script-context" data-story-reader tabindex="0" aria-label={excerpt.label + ' 전체'}>
                <p class="script-document-label">{excerpt.label}</p>
                {excerpt.scene && <ScriptLine line={excerpt.scene} src={excerpt.src} />}
                {excerpt.lines.map((line) => <ScriptLine line={line} src={excerpt.src} />)}
              </div>
            </div>
          </div>
        </details>
      )}
      <a class="story-full-link" href="#full-film">풀영상 보기</a>
    </div>
  <span class="story-link" data-story-link aria-hidden="true"></span>
  <span class="story-slit" data-story-slit aria-hidden="true"></span>
  <div class="story-media">
    <div class:list={['story-frame', work.ratio === '9:16' && 'story-frame--vertical']} style={'--story-ratio:' + ratio} data-story-frame>
      {work.hook ? (
        <video data-story-video src={work.hook.clip} poster={work.hook.poster} muted loop playsinline preload="metadata" aria-hidden="true" />
      ) : <img src={work.poster} alt="" loading="eager" decoding="async" />}
    </div>
  </div>
  {work.hook && <button class="story-toggle" type="button" data-story-toggle hidden>클립 재생</button>}
</section>

<script>
  import '../scripts/story-hook';
</script>
