---
type Props = { id: string; title: string; poster: string; ratio: '16:9' | '9:16'; duration: string; start?: number; src?: string; follow?: boolean };
const { id, title, poster, ratio, duration, start = 0, src, follow = false } = Astro.props;
const youtubeUrl = `https://www.youtube.com/watch?v=${id}`;
---
<div class="film-player" data-film-root data-youtube-id={id} data-video-title={title} data-ratio={ratio} data-start={start} data-local-src={src} data-film-follow={follow?"true":undefined}>
  <div class="film-anchor" data-film-anchor><div class="film-surface" data-film-surface>
  <div class="film-mini-bar" data-film-mini-bar role="group" aria-label="풀영상 작은 플레이어 조작" hidden>
    <button type="button" data-film-mini-toggle aria-label="풀영상 일시정지">멈춤</button>
    <button type="button" data-film-mini-return aria-label="풀영상 원위치로 돌아가기">원위치</button>
    <button type="button" data-film-mini-close aria-label="작은 플레이어 닫기">닫기 ×</button>
  </div>
  <div class="film-frame" data-film-frame>
    <button class="film-poster" type="button" data-film-play aria-label={`${title} 풀영상 재생`}>
      <img src={poster} alt={`${title} 영상 포스터`} loading="lazy" decoding="async" />
    </button>
  </div>
  </div></div>
  <div class="film-controls">
    <button type="button" class="text-action" data-film-play>{`풀영상 재생 · ${duration}`}</button>
    <button type="button" class="text-action" data-film-large aria-haspopup="dialog" aria-label={`${title} 영상 크게 보기`}>크게 보기</button>
  </div>
  <p class="film-error" data-film-error hidden role="status"><a href={youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube에서 영상 보기 ↗</a></p>
  <noscript><p><a href={src ?? youtubeUrl}>{src ? "영상 파일 보기" : "YouTube에서 영상 보기"}</a></p></noscript>
</div>