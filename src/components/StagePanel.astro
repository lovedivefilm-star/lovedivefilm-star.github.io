---
/**
 * 과정 단계 패널 하나(docs/work-room.md 4-1 ③) — 번호 · 이름 · 사실 칩 1~3 · 그림 1~3 · (01 기획 · 04 세그먼트만) 작가 원문.
 * 화면에 오면 왼쪽 대본 종이에서 data-lit 줄이 밝아진다(site.ts initRoom). 패널 하나 = 한 화면 안.
 * 따온 곳:
 *  · 단계 반복 틀「번호 · 이름 → 매체 → 짧은 글」 = Paragon HOW IT HAPPENED(케이스스터디 CS-13) · 단계 이름 = 작가가 말한 영상 프로세스 순서
 *  · 사실 칩 = JM 소프트웨어 칩(CS-03: 14px/20 · 높이 36 · 6×16 알약) — 우리 바탕에 맞게 테두리만
 *  · 작가 원문 인용 = 안윤준 「세계관 기획 의도」 인용 박스(CS-08: 왼쪽 2px 괘선 + 작은 라벨) · 글 18px/29.25(이재학 CS-12)
 *  · 01 구조 막대 = 기획안의 구성표(작가 원문)를 후킹 타임라인 줄 모양의 가로 막대로 — 구간 폭 = 시간(기존 3차 리듬 막대)
 *  · 04 세그먼트 표 = Scrite 씬 목록(CS-23: 씬 번호 · 머리 · 쪽 · 시간 열 · 모노) — 열을 「컷 · 화면 크기 · 완성본 · 대본」 으로
 *  · 06 컷 띠 = 후킹 타임라인 「편집」 줄(히어로 v1) — 칸 폭 = 컷 길이, 칸마다 그 컷의 완성본 프레임
 *  · 작가 캡처 자리 = 김병석 툴 캡처(CS-26: 540×280 · 점선)
 */
import Pics from './Pics.astro';
import Placeholder from './Placeholder.astro';
import { STAGES, mmss, secs, type SceneProcess, type Stage } from '../data/process/types';

type Props = { s: Stage; p: SceneProcess; vertical: boolean };
const { s, p, vertical } = Astro.props;
const meta = STAGES.find((x) => x.key === s.key)!;
const L = p.excerpt;

// 세그먼트 표 — 앞 행에서 이미 보인 대본 줄은 「앞 컷과 같은 줄」(같은 줄을 되풀이해 늘어놓지 않는다 — 글은 자르지 않는다 · 10-13 메인: 「〃」는 읽는 이에게 낯설어 말로 바꿈)
const seen = new Set<number>();
const rows = (s.segments ?? []).map((g) => ({
  g,
  lines: g.lines.map((i) => {
    const again = seen.has(i);
    seen.add(i);
    return { i, l: L[i], again };
  }),
}));

// 01 구조 막대
const bar = s.bar;
const barTotal = bar ? bar.segs.reduce((t, g) => t + (g.b - g.a), 0) : 0;
const here = bar?.segs.find((g) => g.here);
const hereX = bar && here ? ((here.a - bar.segs[0].a) / barTotal) * 100 : 0;

// 06 컷 띠
const st = s.strip;
const bounds = st ? [st.a, ...st.cuts, st.b] : [];
const cells = st ? bounds.slice(0, -1).map((a, k) => ({ a, b: bounds[k + 1], label: st.labels?.[k] ?? `${k + 1}`, frame: st.frames?.[k] })) : [];

const side = s.key === 'plan' && !!s.pics?.length;
---

<section
  class:list={['stage', `st-${s.key}`]}
  id={`stage-${s.key}`}
  data-step={s.key}
  data-lit={s.lit.join(',')}
  data-path={`${meta.no} ${meta.name}`}
  aria-labelledby={`h-${s.key}`}
>
  <header class="st-h">
    <span class="st-n">{meta.no}</span>
    <h3 id={`h-${s.key}`} class="st-t"><span class="line"><span class="line-in">{meta.name}</span></span></h3>
    <ul class="chips" aria-label={`${meta.name} — 무엇 · 무슨 툴`}>
      {s.chips.map((c) => <li>{c}</li>)}
    </ul>
  </header>

  <div class="st-body">
    {s.key === 'plan' && (
      <div class:list={['st-duo', { solo: !side }]}>
        {s.text && (
          <div class="quote">
            <p class="quote-k">{s.text.label}</p>
            {s.text.lines.map((l) => <p class="quote-p"><span data-src={l.src}>{l.t}</span></p>)}
          </div>
        )}
        {side && <Pics pics={s.pics!} cls="side" />}
      </div>
    )}

    {bar && (
      <figure class="bar" aria-label={`${bar.label} — ${bar.mark}`}>
        <figcaption class="bar-k">{bar.label}</figcaption>
        <ol class="bar-segs" style={`grid-template-columns:${bar.segs.map((g) => `minmax(0, ${(g.b - g.a).toFixed(3)}fr)`).join(' ')}`}>
          {bar.segs.map((g) => (
            <li class:list={['bseg', { here: g.here, tiny: (g.b - g.a) / barTotal < 0.08 }]}>
              <i class="bseg-bar" aria-hidden="true"></i>
              <span class="tm">{g.time}</span>
              {typeof g.name === 'string' ? <span class="nm">{g.name}</span> : <span class="nm" data-src={g.name.src}>{g.name.t}</span>}
              {g.sc && <span class="sc">{g.sc}</span>}
            </li>
          ))}
        </ol>
        <p class="bar-mark" style={`--x:${hereX.toFixed(2)}%`}>{bar.mark}</p>
      </figure>
    )}

    {s.segments && (
      <table class="segtab">
        <thead>
          <tr><th scope="col">컷</th><th scope="col">화면 크기</th><th scope="col">완성본 · 길이</th><th scope="col">그 컷이 맡는 대본</th></tr>
        </thead>
        <tbody>
          {rows.map(({ g, lines }) => (
            <tr class:list={{ off: !g.at }}>
              <td class="c">{g.cut}</td>
              <td class="z">{g.size}</td>
              <td class="t">{g.at ? <><span>{mmss(g.at[0], 1)}</span> · <b>{secs(g.at[0], g.at[1])}</b></> : '완성본에 없음'}</td>
              <td class="l">
                {lines.length
                  ? lines.map(({ l, again }) =>
                      again ? (
                        <span class="ln again">앞 컷과 같은 줄</span>
                      ) : (
                        <span class:list={['ln', `ln-${l.t}`]}>
                          {l.who && <span class="who" data-src={p.src}>{l.who}</span>}
                          <span data-src={p.src}>{l.s}</span>
                        </span>
                      ),
                    )
                  : '—'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    {s.key !== 'plan' && s.text && (
      <div class="quote memo">
        <p class="quote-k">{s.text.label}</p>
        {s.text.lines.map((l) => (
          <p class="quote-p"><span data-src={l.src}>{l.t}</span>{l.to && <span class="to">→ {l.to}</span>}</p>
        ))}
      </div>
    )}

    {st && (
      <figure class:list={['cutstrip', vertical ? 'v' : 'h']} aria-label={`완성본 컷 띠 ${mmss(st.a, 1)} – ${mmss(st.b, 1)}`}>
        <div class="strip-cells">
          {cells.map((c) => (
            <div class="cell" style={`flex:${(c.b - c.a).toFixed(3)} 1 0`}>
              <i class="cell-img" style={c.frame ? `background-image:url('${c.frame}')` : undefined} aria-hidden="true"></i>
              <span class="cell-k">{c.label}<b>{secs(c.a, c.b)}</b></span>
            </div>
          ))}
        </div>
        <figcaption>완성본 {mmss(st.a, 1)} – {mmss(st.b, 1)} · 컷 경계 {st.cuts.length}곳</figcaption>
      </figure>
    )}

    {s.key !== 'plan' && (s.pics?.length || s.capture) && (
      <div class:list={['st-media', { duo: !!s.capture && !!s.pics?.length }]}>
        {s.pics?.length ? <Pics pics={s.pics} /> : null}
        {s.capture && (
          <figure class="capbox">
            <span class="capbox-in">{s.capture}<br /><Placeholder kind="capture" /></span>
          </figure>
        )}
      </div>
    )}
  </div>
</section>
