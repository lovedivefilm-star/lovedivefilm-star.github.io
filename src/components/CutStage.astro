---
/**
 * 「한 컷이 만들어진 순서」 — 고정 무대 하나 + 스크롤 4걸음(메인 지시 10-14 · 작가 「연결과정이 친절하게 보여야지」).
 * 문법: 시안 히어로_v1 의 연결선(대본 줄 → 화면)을 과정 전체로. 무대는 한 화면, 핀 구간 4 × 70vh(GSAP ScrollTrigger pin · scrub · 걸음 snap).
 *  1 대본 — 문장이 뜨고 그림이 될 낱말에 밑줄(포인트색)
 *  2 대본 → 시트 — 밑줄 낱말에서 선이 그어져 시트의 그 부분(1px 상자)에 닿는다
 *  3 시트 → 연출 — 시트는 왼쪽 아래로 물러나고 연출 그림이 그 자리로, 같은 인물 영역끼리 선
 *  4 연출 → 완성 — 같은 크기 · 같은 자리에 겹쳐 왼→오 와이프로 완성 프레임이 드러남 · 끝에 「▶ 이 장면 보기」
 * 왼쪽 위 걸음 표시 4칸(지금 걸음 밝게 · 누르면 그 걸음으로). 움직임 줄이기 = 핀 없이 4장면 세로 · 선은 그려진 상태(src/scripts/site.ts initCut).
 * 상자 · 선은 영상이 아니라 정지 그림 위 표시(허용).
 */
import type { Cut } from '../data/cut';
import { mmss } from '../data/process/types';

type Props = { cut: Cut; slug: string };
const { cut, slug } = Astro.props;

// 문장을 밑줄 낱말 기준으로 나눈다(글자는 그대로)
const parts: { t: string; w?: number }[] = [];
{
  let rest = cut.sentence;
  while (rest) {
    let hit = -1;
    let wi = -1;
    cut.words.forEach((w, i) => {
      const k = rest.indexOf(w);
      if (k >= 0 && (hit < 0 || k < hit)) {
        hit = k;
        wi = i;
      }
    });
    if (hit < 0) {
      parts.push({ t: rest });
      break;
    }
    if (hit > 0) parts.push({ t: rest.slice(0, hit) });
    parts.push({ t: cut.words[wi], w: wi });
    rest = rest.slice(hit + cut.words[wi].length);
  }
}
const sheetWord = cut.words.indexOf(cut.sheet.word);
const boardFrom = cut.board.from.kind === 'word' ? { word: cut.words.indexOf(cut.board.from.word) } : { sheet: cut.board.from.box };
const frameAr = cut.final.w / cut.final.h;
const at = Math.floor(cut.final.t);
const box = (b: number[]) => `left:${b[0]}%;top:${b[1]}%;width:${b[2]}%;height:${b[3]}%`;
const steps = ['대본', '시트', '연출', '완성'];
---

<section class="cut" data-process data-cut={slug} aria-labelledby="h-cut">
  <div class="cut-stage" data-stage data-state="4" style={`--far:${frameAr.toFixed(4)};--sar:${(cut.sheet.w / cut.sheet.h).toFixed(4)}`}>
    <div class="cut-head">
      <h2 class="lab" id="h-cut">한 컷이 만들어진 순서</h2>
      <ol class="cut-steps" data-steps>
        {steps.map((s, i) => (
          <li>
            <button type="button" data-step-go={i} aria-current={i === 3 ? 'step' : undefined}>
              {s}
            </button>
          </li>
        ))}
      </ol>
    </div>
    <p class="cut-sent" data-sent data-src={cut.src}>
      {parts.map((p) => (p.w !== undefined ? <u data-word={p.w}>{p.t}</u> : p.t))}
    </p>
    <figure class="cut-sheet" data-sheet>
      <img src={cut.sheet.img} alt={cut.sheet.alt} width={cut.sheet.w} height={cut.sheet.h} loading="lazy" decoding="async" />
      <i class="box" data-box="sheet" style={box(cut.sheet.box)}></i>
      {boardFrom.sheet && <i class="box" data-box="sheet2" style={box(boardFrom.sheet)}></i>}
    </figure>
    <figure class="cut-frame" data-frame data-play data-start={at} title={`완성본에서 이 장면 보기 · ${mmss(at)}`}>
      <img class="board" data-board src={cut.board.img} alt={cut.board.alt} loading="lazy" decoding="async" />
      <img class="final" data-final src={cut.final.img} alt={cut.final.alt} loading="lazy" decoding="async" />
      <i class="box" data-box="board" style={box(cut.board.box)}></i>
    </figure>
    <svg class="cut-lines" aria-hidden="true">
      <line data-line="1" data-from-word={sheetWord} />
      <line data-line="2" data-from-word={boardFrom.word ?? ''} />
    </svg>
    <div class="cut-caps">
      <p data-cap="0">{cut.step1}</p>
      <p data-cap="1">{cut.sheet.cap}</p>
      <p data-cap="2">{cut.board.cap}<span class="note">{cut.board.note}</span></p>
      <p data-cap="3">
        {cut.final.cap}
        <button type="button" class="play" data-play data-start={at} aria-pressed="false">{`▶ 이 장면 보기 · ${mmss(at)}`}</button>
      </p>
    </div>
  </div>
</section>
